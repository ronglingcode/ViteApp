{
  "name": "viteapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test:services": "node --experimental-strip-types scripts/generateServiceFixtures.mjs --check && node --experimental-strip-types --test src/trading/libraries/broker/schwab/oauth.test.ts",
    "test:massive": "node --experimental-strip-types scripts/generateMassiveFixtures.mjs --check",
    "test:direct-execution": "node --experimental-strip-types --test src/bookmap/directExecution.test.ts src/bookmap/directEntryExecution.test.ts",
    "test:extended-execution": "node --experimental-strip-types scripts/generateExtendedExecutionFixtures.mjs --check && node --test scripts/nativeEntryState.test.mjs",
    "dev": "vite",
    "build": "tsc -p tsconfig.trading.json && tsc && vite build",
    "preview": "vite preview",
    "test:bookmap-price": "node --experimental-strip-types --test src/bookmap/priceNormalization.test.ts",
    "test:bookmap-vwap": "node --experimental-strip-types --test src/bookmap/vwapUpdate.test.ts",
    "test:exit-order-pairs": "node --experimental-strip-types --test src/utils/exitOrderPairs.test.ts",
    "test:core-target-exits": "node --experimental-strip-types --test src/controllers/coreTargetExitRules.test.ts",
    "test:new-position": "node --experimental-strip-types --test src/bookmap/newPositionTransition.test.ts"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "firebase": "^12.5.0",
    "sunrise-tv-lightweight-charts": "^4.0.0"
  }
}
